gonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="1" source="n46" target="n30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n108" value="uses" style="endArrow=open;endSize=8;dashed=1;edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="1" source="n46" target="n42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n109" value="uses" style="endArrow=open;endSize=8;dashed=1;edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="1" source="n46" target="n50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n110" value="" style="endArrow=block;endFill=0;endSize=12;dashed=1;edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="1" source="n66" target="n42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n111" value="" style="endArrow=block;endFill=0;endSize=12;dashed=1;edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="1" source="n70" target="n50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n112" value="" style="endArrow=block;endFill=0;endSize=12;dashed=1;edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="1" source="n78" target="n74"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n113" value="uses" style="endArrow=open;endSize=8;dashed=1;edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="1" source="n54" target="n74"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n114" value="uses" style="endArrow=open;endSize=8;dashed=1;edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="1" source="n58" target="n74"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n115" value="records" style="endArrow=open;endSize=8;dashed=1;edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="1" source="n58" target="n62"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n116" value="&lt;b&gt;Design Patterns Used&lt;/b&gt;&lt;br&gt;1. Strategy Pattern (Late Penalty)&lt;br&gt;- ILatePenaltyPolicy and StandardLatePenaltyPolicy&lt;br&gt;- Chosen because the penalty rule may change in future&lt;br&gt;- Keeps the submission logic open for extension without modification&lt;br&gt;2. Repository Pattern (Data Access)&lt;br&gt;- ISubmissionRepository and SQLiteSubmissionRepository&lt;br&gt;- Separates business logic from data storage&lt;br&gt;- Allows easier testing and future database changes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1"><mxGeometry x="0" y="1520" width="520" height="190" as="geometry"/></mxCell><mxCell id="n117" value="&lt;b&gt;SOLID Principles Applied&lt;/b&gt;&lt;br&gt;1. SRP - Each class has one responsibility (e.g. MarkingService only handles marking)&lt;br&gt;2. OCP - New penalty rules or repositories can be added without changing existing code&lt;br&gt;3. LSP - Subclasses (Administrator, Lecturer, HoD, Student) can be used wherever a User is expected&lt;br&gt;4. ISP - Interfaces are small and focused (e.g. ISubmissionRepository, IMarkRepository)&lt;br&gt;5. DIP - High-level classes depend on abstractions (interfaces) rather than concrete classes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1"><mxGeometry x="560" y="1520" width="760" height="140" as="geometry"/></mxCell><mxCell id="n118" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Solid line, hollow triangle: inheritance&lt;br&gt;Dashed line, hollow triangle: realisation (implements)&lt;br&gt;Dashed line, open arrow: dependency (uses)&lt;br&gt;Plain line: association (with multiplicity)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1"><mxGeometry x="1360" y="1520" width="380" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>